# =============================================================================
# Environment variables — macau-gaming-marketing-ai-project
#
# Copy to .env and fill in the required values:
#   cp .env.example .env
#
# Docker vs local dev notes:
#   docker-compose.yml overrides MONGODB_URI and LITELLM_BASE_URL automatically
#   with internal Docker service names. The values here are for local dev only.
# =============================================================================

# ---- Frontend (Next.js) -----------------------------------------------------
# Where the Next.js server-side rewrite proxies /api/* calls.
# Local dev : http://localhost:8000
# Docker    : overridden by docker-compose.yml → http://backend:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---- MongoDB ----------------------------------------------------------------
# Local dev : use your Atlas connection string below
# Docker    : overridden by docker-compose.yml → mongodb://mongodb:27017/?directConnection=true
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB=casino_marketing_demo
# Temporary workaround for TLS handshake/cert issues in non-production envs.
# WARNING: This disables certificate and hostname verification.
MONGODB_TLS_INSECURE=false
VECTOR_EMBEDDING_DIM=1024

# ---- Seeding ----------------------------------------------------------------
SEED_PATRON_COUNT=300
SEED_TABLE_COUNT=30

# ---- LiteLLM gateway (chat only) -------------------------------------------
# The Python backend uses this for chat completions (Azure OpenAI behind
# LiteLLM). Embeddings do NOT go through the gateway — they are produced
# in-process by the voyageai[local] SDK.
# Local dev : http://localhost:4000
# Docker    : overridden by docker-compose.yml → http://litellm:4000
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-change-me
LLM_CHAT_MODEL=chat-primary

# ---- Azure OpenAI (consumed by the LiteLLM container) ----------------------
AZURE_OPENAI_ENDPOINT=https://<your-azure-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# LITELLM_MASTER_KEY must match LITELLM_API_KEY above.
LITELLM_MASTER_KEY=sk-litellm-change-me

# ---- Voyage embeddings (local, no API key required) ------------------------
LLM_EMBEDDING_MODEL=voyage-4-nano
VOYAGE_API_KEY=
EMBED_WARMUP_ON_START=true

# ---- Optional: OpenAI fallback for LiteLLM chat routing --------------------
# OPENAI_API_KEY=

# ---- Configure the TLS connection to MongoDB ------------------------
MONGODB_TLS_INSECURE=true
