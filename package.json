{
  "name": "macau-gaming-marketing-ai-project",
  "version": "1.0.0",
  "description": "Casino patron marketing platform data model and mock data generator for MongoDB Atlas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx src/seed/seed.ts",
    "seed:dry": "tsx src/seed/seed.ts --dry-run",
    "seed:interactions": "tsx src/seed/seed-interactions.ts",
    "seed:interactions:dry": "tsx src/seed/seed-interactions.ts --dry-run",
    "backfill": "tsx src/scripts/backfill-embeddings.ts",
    "backfill:interactions": "tsx src/scripts/backfill-interaction-embeddings.ts",
    "migrate:activities": "tsx src/scripts/migrate-activities-to-patrons.ts",
    "check": "tsc --noEmit",
    "stop": "kill-port 3000",
    "llm:up": "docker compose -f infra/docker-compose.yml up -d",
    "llm:down": "docker compose -f infra/docker-compose.yml down",
    "llm:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "llm:smoke": "tsx src/web/llm/__smoke__/gateway.smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/langgraph-checkpoint-mongodb": "^1.3.1",
    "dotenv": "^17.4.2",
    "langsmith": "^0.7.3",
    "mongodb": "^7.2.0",
    "next": "^16.2.4",
    "openai": "^4.104.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "kill-port": "^2.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
