# -----------------------------------------------------------------------------
# LLM Gateway infrastructure secrets.
# Copy to `infra/.env` and fill in real values.
#
# This file is consumed ONLY by docker-compose (never by the Next.js app).
# The app talks to LiteLLM via LITELLM_BASE_URL / LITELLM_API_KEY, so app-side
# .env does NOT need any of these provider secrets.
# -----------------------------------------------------------------------------

# ---- Azure OpenAI (primary chat) --------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---- OpenAI (fallback, optional) --------------------------------------------
# Uncomment the fallback block in litellm/config.yaml AND uncomment
# router_settings.fallbacks to activate.
# OPENAI_API_KEY=

# ---- LiteLLM ----------------------------------------------------------------
# Master key that app clients must present as Bearer token.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-change-me

# ---- HuggingFace (optional) --------------------------------------------------
# Only needed if you ever swap TEI's model to a gated model.
# voyage-4-nano is Apache-2.0 and does NOT require a token.
# HF_TOKEN=
